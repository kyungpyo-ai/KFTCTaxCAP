<UserControl x:Class="KFTCTaxCAP.Views.Controls.PaymentSignalWaveIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="440" Height="110"
             d:DesignHeight="110" d:DesignWidth="440">
    <!--
        Phase 42(2026-10-12): "카드 → 승인" 흐름 인디케이터. 이전 안(물결 점·왕복 빛 패킷)은 빈 공간의 장식이라
        무엇을 처리 중인지 알려 주지 못했다(사용자 지적). 왼쪽 카드 아이콘에서 오른쪽 은행(승인 기관) 아이콘으로
        빛 점이 한 방향으로 계속 흘러가고, 흐름이 닿을 때마다 은행 아이콘이 살짝 맥박친다 — "카드 정보를 보내
        승인을 받는 중"으로 읽히게. 한 바퀴 1.0초: 0초 카드 3px 밀림 → 0~0.6초 점이 0.1초 간격으로 켜짐(0.07초에
        켜지고 0.35초에 걸쳐 꺼져 꼬리가 생김 — 방향이 보이게) → 0.6초 은행 1.12배 맥박(0.3초) → 반복.
        (리더기에서 출발해 위로 휘어 오르는 안도 시도했으나 사용자 확인에서 이 안이 낫다고 판단, 2026-10-12.)
        아이콘은 이미지 자산 없이 도형으로 그리고, 점은 코드비하인드가 만든다.
        클래스·파일 이름은 창과의 연결을 유지하려고 그대로 둔다(Play/Stop 인터페이스 동일).
    -->
    <Canvas IsHitTestVisible="False" Width="440" Height="110">
        <!-- 카드 아이콘 (68x46) -->
        <Canvas Canvas.Left="24" Canvas.Top="32" Width="68" Height="46">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CardNudge"/>
            </Canvas.RenderTransform>
            <Rectangle Width="68" Height="46" RadiusX="8" RadiusY="8"
                       Fill="#EFF6FF" Stroke="#2563EB" StrokeThickness="3"/>
            <Rectangle Canvas.Left="12" Canvas.Top="13" Width="16" Height="12" RadiusX="2" RadiusY="2"
                       Fill="#F5B83D"/>
            <Rectangle Canvas.Left="12" Canvas.Top="32" Width="32" Height="4" RadiusX="2" RadiusY="2"
                       Fill="#93C5FD"/>
        </Canvas>

        <!-- 점 흐름은 코드비하인드가 이 캔버스에 만든다 -->
        <Canvas x:Name="Dots" Width="440" Height="110"/>

        <!-- 은행(승인 기관) 아이콘 (68x58) — 흐름이 닿을 때 맥박 -->
        <Canvas x:Name="BankIcon" Canvas.Left="348" Canvas.Top="26" Width="68" Height="58"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="BankScale" ScaleX="1" ScaleY="1"/>
            </Canvas.RenderTransform>
            <Path Data="M34,0 L68,17 L0,17 Z" Fill="#2563EB"/>
            <Rectangle Canvas.Left="8"  Canvas.Top="21" Width="8" Height="25" Fill="#2563EB"/>
            <Rectangle Canvas.Left="23" Canvas.Top="21" Width="8" Height="25" Fill="#2563EB"/>
            <Rectangle Canvas.Left="38" Canvas.Top="21" Width="8" Height="25" Fill="#2563EB"/>
            <Rectangle Canvas.Left="53" Canvas.Top="21" Width="8" Height="25" Fill="#2563EB"/>
            <Rectangle Canvas.Left="0"  Canvas.Top="50" Width="68" Height="8" RadiusX="2" RadiusY="2" Fill="#2563EB"/>
        </Canvas>
    </Canvas>
</UserControl>
