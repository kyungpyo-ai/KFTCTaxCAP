<UserControl x:Class="KFTCTaxCAP.Views.Controls.PaymentProcessingRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="340" Height="226.67"
             d:DesignHeight="226.67" d:DesignWidth="340">
    <!--
        원판(circle.png) 위·리더기 몸통 아래 레이어(PaymentNoticeWindow.xaml 참고 — 몸통에 가려지는 부분은
        몸통 픽셀이 자연스럽게 덮는다).
        2026-10-12 재구성: 원판 테두리를 도는 진행광(링 아크 + 헤드라이트 점)은 "도는 게 어색하고 끊겨 보인다",
        이어 시도한 유리 반사광(빛줄기 스윕)도 "조금 이상하다"는 사용자 피드백으로 걷어내고, 테두리가 박자에 맞춰
        부드럽게 밝아졌다 어두워지는 맥박만 남겼다 — 움직이는 요소가 없어 끊겨 보일 일이 없고, 위쪽
        "카드 → 은행" 흐름이 주인공이 된다. 타원 경로(중심 170.18,135.10 반경 147.46,76.80)의 실측 근거는
        코드비하인드 주석 참고. 클래스·파일 이름은 창과의 연결을 유지하려고 그대로 둔다(Play/Stop 동일).
    -->
    <Canvas IsHitTestVisible="False" Width="340" Height="226.67">
        <!-- 기본 트랙 — 항상 은은하게 보인다 -->
        <Path Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#3B82F6" StrokeThickness="3" Opacity="0.3"/>
        <!-- 맥박 글로우 — 박자마다 밝아졌다 어두워진다 -->
        <Path x:Name="PulseGlow" Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#60A5FA" StrokeThickness="8" Opacity="0">
            <Path.Effect>
                <BlurEffect Radius="8"/>
            </Path.Effect>
        </Path>
        <!-- 맥박 코어 — 글로우 안쪽의 선명한 밝은 선 -->
        <Path x:Name="PulseCore" Data="M 170.18,58.30 A 147.46,76.80 0 1 1 170.17,58.30 Z"
              Stroke="#DBEAFE" StrokeThickness="2.5" Opacity="0"/>
    </Canvas>
</UserControl>