<Window x:Class="KFTCTaxCAP.Views.Dialogs.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:KFTCTaxCAP.Views.Dialogs"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
        알림창(5차 범위 Phase 38 P38-2·P38-3, docs/alert_dialog/PRD.md §3.2~§3.4). 띄우기는 반드시 정적 헬퍼
        AlertDialog.Show(owner, text, caption, kind, buttons)로만 한다(Views/Dialogs/AlertDialog.Show.cs).

        구조: 창 = 투명. 그 안에 그림자용 투명 여백(AlertShadowMargin)을 두고 카드를 그린다(D1).
        그림자(DropShadowEffect)는 텍스트를 담지 않는 별도 배경 Border(ShadowLayer)에만 건다 — Effect가 걸린
        요소의 하위 텍스트는 비트맵으로 합성돼 흐려질 수 있어서다. 실제 내용은 그 위에 겹친 Card Border에 있다.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid x:Name="Root"
          Width="{StaticResource AlertCardWidth}"
          Margin="{StaticResource AlertShadowMargin}">

        <!-- 포커스 링(D5)은 어도너로 그려진다 — 카드와 같은 층에 둔다. -->
        <AdornerDecorator>
        <Grid>

        <!-- 그림자 전용 배경(텍스트 없음) -->
        <Border x:Name="ShadowLayer"
                CornerRadius="{StaticResource AlertCardCornerRadius}"
                Background="{StaticResource CardBgBrush}">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource AlertShadowColor}"
                                  Opacity="{StaticResource AlertShadowOpacity}"
                                  BlurRadius="{StaticResource AlertShadowBlurRadius}"
                                  ShadowDepth="{StaticResource AlertShadowDepth}"
                                  Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- 카드(내용). 버튼 밖 아무 곳이나 끌면 창 이동(원본 동일).
             ClearType(P38-5 사용자 피드백 "글자가 깨진 느낌"): AllowsTransparency=True 레이어드 창에서는 WPF가
             배경이 투명할 수 있다고 보고 텍스트를 그레이스케일 AA로 그린다. 카드는 불투명 흰 배경이라
             ClearTypeHint=Enabled로 ClearType을 다시 켠다(.NET 4+). 이 힌트가 먹으려면 텍스트 조상에 Effect·
             Opacity<1·OpacityMask·비항등 변환이 없어야 한다 — 그림자 Effect는 형제 ShadowLayer에만 있고,
             진입 애니메이션(반투명·확대)도 같은 이유로 두지 않는다(D4 철회, 2026-10-01). -->
        <Border x:Name="Card"
                RenderOptions.ClearTypeHint="Enabled"
                CornerRadius="{StaticResource AlertCardCornerRadius}"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource AlertCardBorderBrush}"
                BorderThickness="{StaticResource AlertCardBorderThickness}"
                Padding="{StaticResource AlertCardPadding}"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 아이콘 + 제목/본문 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <dialogs:AlertIcon Grid.Column="0"
                                       VerticalAlignment="Top"
                                       Kind="{Binding Kind, Mode=OneTime}"/>

                    <StackPanel Grid.Column="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <!-- 본문 없음: 제목을 아이콘 세로 중앙(PRD §2.2) -->
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="{StaticResource AlertTextColumnMargin}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBody, Mode=OneTime}" Value="True">
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="Margin" Value="{StaticResource AlertTextColumnWithBodyMargin}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource AlertTitleTextStyle}"
                                   Text="{Binding Title, Mode=OneTime}"/>

                        <!-- D6: 본문 최대 높이 320, 넘치면 본문만 스크롤 -->
                        <!-- 스크롤 영역은 클립 때문에 별도 중간 표면으로 그려져 카드의 ClearTypeHint가 닿지 않는다
                             (실측: 카드에만 걸면 제목은 ClearType, 본문은 그레이스케일). 여기에도 건다. -->
                        <ScrollViewer x:Name="BodyScroll"
                                      RenderOptions.ClearTypeHint="Enabled"
                                      Style="{StaticResource AlertBodyScrollViewerStyle}"
                                      Margin="{StaticResource AlertBodyMargin}"
                                      Visibility="{Binding HasBody, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="BodyText"
                                       Style="{StaticResource AlertBodyTextStyle}"
                                       Text="{Binding Body, Mode=OneTime}"/>
                        </ScrollViewer>

                        <!-- 본문이 320 안에 들어가면(대부분) 코드비하인드가 BodyText를 여기로 옮기고 ScrollViewer를 접는다.
                             ScrollContentPresenter의 클립이 ClearType을 약하게 만들기 때문이다(실측: 스크롤 없이 그리면
                             본문 ClearType이 비레이어드 창과 같아짐). 넘칠 때만 스크롤 영역을 그대로 쓴다. -->
                        <Border x:Name="BodyPlain"
                                RenderOptions.ClearTypeHint="Enabled"
                                Margin="{StaticResource AlertBodyMargin}"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- 버튼 줄: 1개면 전체 폭, 2개면 균등(간격 14). D3 주 버튼 왼쪽 -->
                <Border Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="{StaticResource AlertButtonRowMargin}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBody, Mode=OneTime}" Value="False">
                                    <Setter Property="Margin" Value="{StaticResource AlertButtonRowNoBodyMargin}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl x:Name="ButtonsHost"
                                  Margin="{StaticResource AlertButtonRowOuterMargin}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                  ItemsSource="{Binding Buttons, Mode=OneTime}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="ChoiceButton"
                                        Margin="{StaticResource AlertButtonItemMargin}"
                                        Style="{StaticResource AlertSecondaryButtonStyle}"
                                        Content="{Binding Label, Mode=OneTime}"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPrimary, Mode=OneTime}" Value="True">
                                        <Setter TargetName="ChoiceButton" Property="Style" Value="{StaticResource AlertPrimaryButtonStyle}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>
        </Grid>
        </AdornerDecorator>
    </Grid>
</Window>
