<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      이 프로그램은 원캡(KFTCTaxCAP)과 달리 네이티브 32bit DLL을 전혀 로드하지 않는다 — 소켓 너머로
      원캡과 통신할 뿐인 순수 클라이언트다. 그래서 PlatformTarget을 x86으로 고정하지 않고 AnyCPU로
      둔다 — 키오스크 환경(32bit/64bit 어느 쪽이든)을 가리지 않기 위함.
    -->
  </PropertyGroup>

</Project>
